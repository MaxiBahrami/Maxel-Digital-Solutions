{
  "name": "maxel-digital-solutions",
  "version": "1.0.0",
  "private": true,
  "description": "Maxel website with standalone static mode and a PostgreSQL-backed contact inbox.",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node scripts/build.mjs && node --test tests/static.test.mjs tests/postgres.test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build:server": "node scripts/build-server.mjs",
    "test:server": "node --test tests/postgres.test.mjs"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
